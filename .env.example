# Better Auth Configuration
BETTER_AUTH_SECRET="your-32-character-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# Platform Administration
# Single admin email (legacy support)
PLATFORM_ADMIN_EMAIL="your-admin@yourdomain.com"
NEXT_PUBLIC_PLATFORM_ADMIN_EMAIL="your-admin@yourdomain.com"

# Multiple platform admins (comma-separated)
# Example: "admin1@precuityai.com,admin2@precuityai.com,admin3@precuityai.com"
PLATFORM_ADMIN_EMAILS="admin1@precuityai.com,admin2@precuityai.com"
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS="admin1@precuityai.com,admin2@precuityai.com"

# Database (Neon PostgreSQL)
# Get this from your Neon dashboard at https://neon.com
DATABASE_URL="postgresql://username:password@hostname:port/database?sslmode=require"

# Google OAuth (optional)
# Create OAuth credentials at https://console.developers.google.com
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Stripe Configuration
# Get these from your Stripe dashboard at https://dashboard.stripe.com
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email Service (Resend)
# Get API key from https://resend.com/api-keys
RESEND_API_KEY="re_..."
FROM_EMAIL="PrecuityAI <cristian@prodiusenterprise.com>"

# Application URLs
NEXT_PUBLIC_BASE_URL="http://localhost:3000"